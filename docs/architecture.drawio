;[presence.cpp, NimBLE]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;HID-looking BLE device, pairing window, RPA scan.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="455" width="250" height="90" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b style='font-size:14px'&gt;Desk client&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[desk.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Own task: polls the desk, queues commands, hold heartbeat.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="555" width="250" height="90" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b style='font-size:14px'&gt;Smart desk&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1420" y="760" width="200" height="80" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style='font-size:14px'&gt;Phone&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[BLE]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1420" y="460" width="200" height="80" as="geometry"/></mxCell><mxCell id="c54" value="near or away, pair, forget" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c50"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="480"/></Array></mxGeometry></mxCell><mxCell id="c55" value="recall, hold, stop, timer, away" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="600"/></Array></mxGeometry></mxCell><mxCell id="c56" value="adverts, bonded link" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c53" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="HTTP JSON" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="600"/><mxPoint x="1360" y="800"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="C3 Apps Script components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Level 3 · Components of the Apps Script web app (apps-script/Code.gs)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="One copy runs in each Google account, as that account. Every call is GET &amp;lt;url&amp;gt;?token=T&amp;amp;action=..." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;Firmware sync worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Container]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="220" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;doGet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Checks the token, picks the action, returns JSON.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="240" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;feed_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: none]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Account, time zone, calendars, next 7 days of events, open tasks.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;range_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: range]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Events between two times (week view).&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="240" width="260" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;setTaskStatus_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: complete / uncomplete]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Marks a task done or open again.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;dismissEvent_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: dismiss]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Remembers a dismissed meeting until it ends.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;showCalendar_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: showcal]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Shows or hides one calendar on the display.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="630" width="260" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:14px'&gt;addTask_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: add]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Quick add: a new task in a list, with a due day.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:14px'&gt;setTaskDue_&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Action: due]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;End-of-day review: moves a task to another day.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="8