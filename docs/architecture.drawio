<mxfile host="build_drawio.py" type="device"><diagram id="p0" name="C1 System context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Level 1 · System context&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Who uses the calendar display and which outside systems it depends on." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;Andrei&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Owner. Looks at the display, taps it, sets it up from a phone, and pushes new code.&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="260" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;Calendar display&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;CrowPanel 5&quot; touch screen that shows meetings from several Google accounts and Google Tasks, and lets you dismiss meetings and tick tasks.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="340" height="160" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;Google Calendar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Meetings in every Google account.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="260" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;Google Tasks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;To-do lists in every Google account.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="820" width="260" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Code, automatic builds and firmware releases.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="260" height="140" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;Internet time servers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;time.google.com, pool.ntp.org&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="780" y="690" width="260" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;Outlook / iCloud calendars&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Optional, subscribed in Google Calendar by ICS link.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="260" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Reads meetings and tasks, dismisses, ticks; sets up accounts from a phone&lt;br&gt;&lt;span style='font-size:10px'&gt;[touch screen, web page]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Pushes code to main&lt;br&gt;&lt;span style='font-size:10px'&gt;[git]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Reads meetings, hides dismissed ones&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS via Apps Script]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Reads tasks, marks them done&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS via Apps Script]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Sets its clock&lt;br&gt;&lt;span style='font-size:10px'&gt;[NTP]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Downloads new firmware&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b style='font-size:14px'&gt;Smart standing desk&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Andrei's own desk (SmartStandingDeskDualCore) with its web API.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="260" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:14px'&gt;Andrei's phone&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External device]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Paired over Bluetooth LE to tell when Andrei is near.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1100" y="820" width="260" height="120" as="geometry"/></mxCell><mxCell id="c18" value="Shown as calendars&lt;br&gt;&lt;span style='font-size:10px'&gt;[ICS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Reads height, recalls memories, stands up for meetings&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTP on Wi-Fi]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Sees it nearby&lt;br&gt;&lt;span style='font-size:10px'&gt;[Bluetooth LE]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="C2 Containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Level 2 · Containers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="The parts of the calendar display system and how they talk to each other." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Calendar display&lt;/b&gt; [Software system]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1120" height="760" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;Andrei&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Person]&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="220" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;Touch screen and speaker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Hardware: 800x480 RGB LCD, GT911 touch, I2S amplifier]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Shows the UI, reads taps, plays the chime.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="280" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;Setup web page&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTML served by the firmware at http://calendar.local]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Tabs: Accounts (Google, ICS links), Desk &amp;amp; sync (desk, sync interval), Device (update link, upload). The PIN changes at every restart and is shown on the Accounts screen.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="300" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;Firmware&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[C++, Arduino, FreeRTOS, LVGL 8, LovyanGFX on the ESP32-S3]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;UI on core 1; Wi-Fi, sync, web page and updates on core 0.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="340" height="160" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;Settings&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[NVS flash (Preferences)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Wi-Fi, accounts, display options as JSON, saved 5 s after the last change.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="220" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;microSD card&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[FAT, JSON files]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Offline copy of each account's feed, settings backup, radar counts. Optional.&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="220" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:14px'&gt;Apps Script web app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Google Apps Script (one copy per Google account)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Returns meetings, tasks, calendars, travel times, birthdays, holidays and frequent tasks as JSON; dismisses, completes, adds and moves tasks, stars meetings.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="340" height="160" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:14px'&gt;Build pipeline&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[GitHub Actions, PlatformIO, esptool]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Builds 7 inch and 5 inch on every push; version 0.2.&amp;lt;run&amp;gt;; a release from main, a builds/&amp;lt;branch&amp;gt; branch for the rest.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="880" y="800" width="260" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:14px'&gt;Firmware releases&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[GitHub Releases]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;firmware.bin, factory.bin, manifest.json&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="610" y="800" width="230" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:14px'&gt;Google Calendar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="480" width="220" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:14px'&gt;Google Tasks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="220" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:14px'&gt;Time servers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="220" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:14px'&gt;Google Maps&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="800" width="220" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:14px'&gt;Room sensors (optional)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Hardware: BH1750 light sensor on I2C, PIR on IO44]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Room light for the backlight, motion to wake.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="260" height="120" as="geometry"/></mxCell><mxCell id="c18" value="Reads and taps" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Adds accounts, uploads firmware&lt;br&gt;&lt;span style='font-size:10px'&gt;[browser, HTTP]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Pushes code&lt;br&gt;&lt;span style='font-size:10px'&gt;[git]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="135"/><mxPoint x="1200" y="875"/></Array></mxGeometry></mxCell><mxCell id="c21" value="Taps&lt;br&gt;&lt;span style='font-size:10px'&gt;[I2C]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Draws frames, plays sound&lt;br&gt;&lt;span style='font-size:10px'&gt;[RGB bus, I2S]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="620"/></Array></mxGeometry></mxCell><mxCell id="c23" value="Account and firmware requests&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTP form, PIN]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="Reads and saves settings" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Caches feeds, backs up settings&lt;br&gt;&lt;span style='font-size:10px'&gt;[SPI]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Fetches feed, sends actions&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS GET + token, JSON]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="Reads events, birthdays, holidays&lt;br&gt;&lt;span style='font-size:10px'&gt;[CalendarApp, Calendar API]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Reads, adds and updates tasks&lt;br&gt;&lt;span style='font-size:10px'&gt;[Tasks API]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Travel time from home&lt;br&gt;&lt;span style='font-size:10px'&gt;[Maps DirectionFinder]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Light level, motion&lt;br&gt;&lt;span style='font-size:10px'&gt;[I2C, GPIO]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="Publishes on push to main" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Checks manifest, downloads firmware&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTPS]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Sets the clock&lt;br&gt;&lt;span style='font-size:10px'&gt;[NTP]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b style='font-size:14px'&gt;Smart standing desk&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External system: MicroPython web API at smartdesk-a43c.local]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="960" width="220" height="100" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style='font-size:14px'&gt;Phone&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[External device, paired over BLE]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="220" height="80" as="geometry"/></mxCell><mxCell id="c36" value="Status, memory recall, hold, timer, away mode&lt;br&gt;&lt;span style='font-size:10px'&gt;[HTTP + bearer login]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="1010"/></Array></mxGeometry></mxCell><mxCell id="c37" value="Advertises (resolvable private address)&lt;br&gt;&lt;span style='font-size:10px'&gt;[Bluetooth LE]&lt;/span&gt;" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c35" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="1080"/><mxPoint x="360" y="720"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="C3 Firmware components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Level 3 · Components of the firmware&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Core 1 runs only the UI so taps never wait on the network. Core 0 runs the background tasks. They share data through the sync snapshot (copied under a lock) and the settings store." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Core 1 · UI task&lt;/b&gt; (Arduino loop)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="640" height="760" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Core 0 · background tasks&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="620" height="760" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;Main loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[main.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Starts every module; every loop: new snapshot to UI, UI tick, LVGL draw.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;UI core&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ui.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Navigation, reminders, night mode, dimming, auto-update timing, toasts, rebuild when a layout setting changes.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="270" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;Screens&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ui_home, ui_detail, ui_week, ui_tasks, ui_night, ui_wifi, ui_accounts, ui_settings, ui_features, ui_dates, ui_desk]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Built once; data parts rebuilt only when changed. Settings is a tile dashboard, Features a grid of 18 cards (tap = on/off, hold = options and layout A, B or C), Accounts a master/detail list.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="270" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;Overlays&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ui_overlays, ui_quickadd, ui_focus, ui_daily, ui_alerts, ui_meeting, ui_radar, ui_roulette, ui_presence]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Reminder, update, theme and layout pickers, quick add, focus timer, daily summary, end-of-day review, conflicts, leave-by.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="490" width="270" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;Themes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[theme.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Six colour sets (Midnight, Ocean, Forest, Sunset, Paper, High contrast).&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:14px'&gt;Display driver&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[display.cpp, LovyanGFX]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;RGB panel, touch, backlight, LVGL flush with DMA.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:14px'&gt;Battery&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[battery.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Optional MAX17048 fuel gauge.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="240" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:14px'&gt;Sensors&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[sensors.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Optional BH1750 room light and PIR motion.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="240" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:14px'&gt;Sync worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[sync.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fetches every account (feed v2 with a hash), queues taps as actions, keeps the snapshot, week fetch, offline cache.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="270" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:14px'&gt;Wi-Fi manager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[wifi_mgr.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Connect, reconnect, scan.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:14px'&gt;Web server&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[web.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Setup page, PIN check (5 wrong = 1 min lock), accounts, ICS links, desk, firmware upload, harness routes.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="250" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:14px'&gt;Updater&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ota.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Reads the manifest, installs to the other app slot, restarts.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:14px'&gt;Audio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[audio.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Chime generator on I2S.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="210" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:14px'&gt;Settings store&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[settings.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Thread-safe settings with a version counter.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="660" width="270" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:14px'&gt;SD storage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[storage.cpp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Atomic file writes.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="660" width="250" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:14px'&gt;Apps Script web app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Container]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1420" y="130" width="200" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style='font-size:14px'&gt;Firmware releases&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Container]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1420" y="600" width="200" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style='font-size:14px'&gt;Touch screen&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Hardware]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="200" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:14px'&gt;NVS flash&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Container]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="760" y="920" width="200" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:14px'&gt;microSD card&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Container]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="920" width="200" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:14px'&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Phone or PC]&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1420" y="335" width="200" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style='font-size:14px'&gt;Test harness&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[harness.cpp, tools/harness.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Serial and HTTP commands (tap, screen, shot, heap, log). Runs on the UI task.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="690" width="270" height="110" as="geometry"/></mxCell><mxCell id="c27" value="ui_update, ui_tick" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="lv_timer_handler" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="show, refresh" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="reminder, update dialog" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="560"/></Array></mxGeometry></mxCell><mxCell id="c31" value="colours" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#707070;strokeWidth=1.5;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"