" as="geometry"/></mxCell><mxCell id="c10" value="PIN right, link starts with https://, http:// or webcal://, fewer than 6?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325.0" y="348.0" width="200" height="84" as="geometry"/></mxCell><mxCell id="c11" value="Add the link with the next colour; save" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580.0" y="453.0" width="230" height="66" as="geometry"/></mxCell><mxCell id="c12" value="Add &amp;amp;ics=URL to the first account's feed and week requests" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850.0" y="549.0" width="230" height="66" as="geometry"/></mxCell><mxCell id="c13" value="Fetch the link (cached 10 min), expand recurring events, return them like Google events" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120.0" y="645.0" width="230" height="66" as="geometry"/></mxCell><mxCell id="c14" value="Events appear on Home and Week" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80.0" y="746.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="c15" value="Show the error" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350.0" y="458.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=blockThin;endFill=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#5A6B80;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxG